# =============================================================================
# KorUZ Mall — environment configuration template.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# (see .gitignore); this template is the only env file that ships with the
# repo. Every variable in `api/core/config.py:Settings` appears here, plus
# the docker-compose-only operator knobs at the bottom.
#
# Authoring rules:
#   * Comments live on their own line, NEVER after `KEY=value`.
#     pydantic-settings' dotenv parser does not strip inline `#` comments,
#     so `KEY=value  # note` would store the literal `"value  # note"`.
#   * Optional fields whose type is a URL or EmailStr are kept commented
#     out below; uncomment and fill in a real value to enable them.
#     A blank `KEY=` would fail URL/email validation at boot.
#   * Multi-value fields (BACKEND_CORS_ORIGINS, ADMIN_NOTIFY_EMAILS) accept
#     either a comma-separated string OR a JSON array literal.
#
# Variables marked **REQUIRED** must be set; unset/blank values will fail
# fast at app boot.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# `development` enables Swagger UI (/api/v1/docs) and verbose error pages.
# `production` disables docs/redoc and tightens log output. `test` is for
# pytest runs against ephemeral DBs. `staging` mirrors production with
# loosened observability defaults.
# Allowed: development | staging | production | test
ENVIRONMENT=development
PROJECT_NAME=KorUZ Mall API
API_V1_PREFIX=/api/v1
# Allowed: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# The frontend's public origin. Used as the CORS allowlist fallback and
# embedded into outbound emails (e.g. seller-dashboard URLs).
FRONTEND_URL=http://localhost:3000

# Comma-separated OR JSON array. Empty -> falls back to FRONTEND_URL.
# Add staging/preview origins here without losing the production one:
#   BACKEND_CORS_ORIGINS=http://localhost:3000,https://app.koruz.example.com
BACKEND_CORS_ORIGINS=


# -----------------------------------------------------------------------------
# Database — supply DATABASE_URL OR the discrete POSTGRES_* parts.
# -----------------------------------------------------------------------------
# If you set DATABASE_URL, it overrides every POSTGRES_* var. The asyncpg
# driver is forced automatically (postgresql:// becomes postgresql+asyncpg://).
# Examples:
#   DATABASE_URL=postgresql+asyncpg://koruz:koruz@postgres:5432/koruz
#   DATABASE_URL=postgresql://user:pwd@managed-pg.example.com:5432/koruz
# DATABASE_URL=

# Use `localhost` when running the API outside Docker.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=koruz
# CHANGE FOR PRODUCTION
POSTGRES_PASSWORD=koruz
POSTGRES_DB=koruz

# Connection-pool tuning. Leave at defaults unless you've measured.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 30 min — recycles connections before pgbouncer/RDS idle-cuts.
DB_POOL_RECYCLE_SECONDS=1800
# Cheap SELECT 1 before a checkout, catches dropped sockets.
DB_POOL_PRE_PING=true
# `true` logs every SQL statement — never enable in production.
DB_ECHO=false


# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
# REDIS_URL also serves as the default Celery broker + result backend
# unless CELERY_* are set explicitly. Database 0 is used for Celery; the
# refresh-token whitelist + FX cache live in REDIS_AUTH_DB (default 1) so
# a Celery flush can never wipe sessions and vice-versa.
# Use `redis://localhost:6379/0` outside Docker.
REDIS_URL=redis://redis:6379/0

# Optional explicit overrides — uncomment to point Celery at a different
# instance than the app cache.
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Logical DB index for refresh-token / FX cache keys.
REDIS_AUTH_DB=1


# -----------------------------------------------------------------------------
# MinIO / object storage
# -----------------------------------------------------------------------------
# MINIO_ENDPOINT — what the API container talks to. In Docker that's the
# service name `minio:9000`. Outside Docker use `localhost:9000`.
#
# MINIO_PUBLIC_ENDPOINT — what the BROWSER will hit when uploading via
# the presigned URLs we hand it. In dev with the API on the host this
# should be `localhost:9000` so the browser can resolve it. In prod it
# should be the public CNAME, e.g. `objects.koruz.example.com`. Leave
# unset (commented) to fall back to MINIO_ENDPOINT (correct for in-cluster
# prod where API and browser hit the same hostname).
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000

# MinIO accepts any region; keep the S3-compatible default.
MINIO_REGION=us-east-1
# CHANGE FOR PRODUCTION
MINIO_ACCESS_KEY=minioadmin
# CHANGE FOR PRODUCTION (min 8 chars enforced by MinIO).
MINIO_SECRET_KEY=minioadmin123
# `true` when the public endpoint is HTTPS.
MINIO_USE_SSL=false

# Private bucket — presigned-URL access only.
MINIO_BUCKET_DOCUMENTS=seller-documents
# Public-read OK (configured by the docker-compose minio-init job).
MINIO_BUCKET_IMAGES=product-images

# Lifetime of generated presigned URLs.
# 15 min — seller upload window.
MINIO_PRESIGNED_PUT_TTL_SECONDS=900
# 5 min — admin doc viewing window.
MINIO_PRESIGNED_GET_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# JWT & password hashing
# -----------------------------------------------------------------------------
# **REQUIRED** — JWT_SECRET_KEY is the HMAC secret for access + refresh
# tokens. MINIMUM 32 chars; longer is better. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   # or:  openssl rand -base64 48
#
# NEVER commit the production value. Rotating this string invalidates
# every issued token; do so deliberately, not accidentally.
JWT_SECRET_KEY=replace-me-with-a-real-secret-at-least-32-chars-long

# Symmetric HMAC; switch to RS256 only if multi-service signing is needed.
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt cost factor. 12 is the project minimum (~250ms on commodity
# hardware in 2026). Bump to 13/14 if your CPU has slack; 15 is the
# pydantic-enforced ceiling.
BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# Leave SMTP_HOST blank in development — the worker's email backend will
# log message bodies instead of trying to connect. Set all four (HOST,
# PORT, USER, PASSWORD) to enable real outbound mail.
SMTP_HOST=
# 587 = STARTTLS submission, 465 = SMTPS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# `true` for port 587 / STARTTLS.
SMTP_USE_TLS=true

# Uncomment and set to a real address to enable outbound mail.
# EMAILS_FROM_ADDRESS=no-reply@koruz.example.com
EMAILS_FROM_NAME=KorUZ Mall

# Comma-separated or JSON array of moderator email addresses. Empty list
# means new-seller / document-uploaded notifications log-and-skip.
ADMIN_NOTIFY_EMAILS=


# -----------------------------------------------------------------------------
# Payment gateways — all optional; absent values disable that gateway.
# -----------------------------------------------------------------------------
# Korean side:
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
KG_INICIS_MERCHANT_ID=
KG_INICIS_SIGN_KEY=

# Uzbek side:
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZCARD_MERCHANT_ID=
UZCARD_SECRET_KEY=


# -----------------------------------------------------------------------------
# FX rate provider — KRW → UZS quote refreshed by the Celery beat job.
# -----------------------------------------------------------------------------
# When EXCHANGE_RATE_PROVIDER_URL is unset, the beat job no-ops and
# checkouts use EXCHANGE_RATE_FALLBACK_KRW_TO_UZS. Set both to keep
# prices fresh in production.
# EXCHANGE_RATE_PROVIDER_URL=https://openexchangerates.org/api/latest.json?base=KRW&symbols=UZS
EXCHANGE_RATE_PROVIDER_KEY=
# Also drives the beat-schedule cadence.
EXCHANGE_RATE_REFRESH_HOURS=6
# Used when the cache is empty (boot, cold dev, tests).
EXCHANGE_RATE_FALLBACK_KRW_TO_UZS=9.5


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Leave blank to disable Sentry. When set, errors are forwarded with
# release/environment tagging.
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Docker-compose-only operator settings.
# These are NOT read by the API; they're consumed by the compose stack
# itself (docker-compose.yml has matching `${VAR:-default}` fallbacks).
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
# CHANGE FOR PRODUCTION
GRAFANA_PASSWORD=admin
